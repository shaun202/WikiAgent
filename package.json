{
  "name": "agents-everywhere-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for the Agents, Everywhere: Bots, Channels & More global hackathon.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/wikiagent",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:wikiagent": "npm run dev --workspace wikiagent",
    "dev:slack": "npm run dev --workspace channel",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "sharp@0.35.4": true,
    "protobufjs@7.6.6": true,
    "@scarf/scarf@1.4.0": true
  }
}
