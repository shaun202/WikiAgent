{
  "name": "wikiagent",
  "version": "0.1.0",
  "private": true,
  "description": "WikiAgent — a retrieval-augmented generation assistant that answers questions from wiki pages you index.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/next/dist/bin/next dev --turbopack -p 3200 -H 127.0.0.1",
    "build": "next build",
    "start": "node --env-file-if-exists=../../.env ../../node_modules/next/dist/bin/next start -p 3200 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "migrate": "node --env-file-if-exists=../../.env --import tsx scripts/migrate.ts",
    "ingest": "node --env-file-if-exists=../../.env --import tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/openai": "^0.4.6",
    "@langchain/textsplitters": "^0.1.0",
    "cheerio": "^1.0.0",
    "langchain": "^0.3.17",
    "next": "^15.5.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0"
  }
}